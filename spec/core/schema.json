{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/BaryoDev/dopaminejs/spec/schema.json",
    "title": "DopamineJS player document, contract 3",
    "description": "What export() returns and what validate() and merge() accept. Only v is required on input; validate fills in the rest. Keys inside the per-device maps are device ids, which are never __proto__, constructor or prototype, and a document holds at most 20 of them across xpBy, xpSpentBy, gamesBy, playsBy and sumsBy.",
    "type": "object",
    "required": ["v"],
    "additionalProperties": false,
    "properties": {
        "v": { "const": 3 },
        "name": { "type": "string" },
        "createdAt": { "type": "number" },
        "lastPlayedAt": { "type": "number" },
        "level": { "type": "integer", "minimum": 1 },
        "longest": { "type": "integer", "minimum": 0 },
        "playDates": {
            "type": "array",
            "items": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        },
        "xpBy": { "$ref": "#/$defs/amounts" },
        "xpSpentBy": { "$ref": "#/$defs/amounts" },
        "gamesBy": { "$ref": "#/$defs/counts" },
        "playsBy": {
            "type": "object",
            "additionalProperties": { "$ref": "#/$defs/counts" }
        },
        "best": { "$ref": "#/$defs/amounts" },
        "sumsBy": {
            "type": "object",
            "additionalProperties": {
                "type": "object",
                "additionalProperties": {
                    "type": "object",
                    "additionalProperties": { "type": "number" }
                }
            }
        },
        "achievements": {
            "type": "object",
            "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "unlockedAt": { "type": "number" },
                    "seen": { "type": "boolean" },
                    "reward": { "type": "number", "minimum": 0 }
                }
            }
        }
    },
    "$defs": {
        "amounts": {
            "type": "object",
            "additionalProperties": { "type": "number", "minimum": 0 }
        },
        "counts": {
            "type": "object",
            "additionalProperties": { "type": "integer", "minimum": 0 }
        }
    }
}
