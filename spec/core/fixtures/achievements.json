        {
            "name": "manual unlock pays once and ignores unknown or unsafe ids",
            "clock": "2026-08-07T09:00:00",
            "config": {
                "builtinAchievements": false,
                "achievements": {
                    "gift": {
                        "name": "Gift",
                        "xp": 40,
                        "when": {
                            "never": true
                        }
                    }
                }
            },
            "steps": [
                {
                    "op": "unlockAchievement",
                    "id": "gift",
                    "expect": {
                        "returns": true,
                        "player": {
                            "xp": 40,
                            "achievements": {
                                "gift": {
                                    "seen": false
                                }
                            }
                        },
                        "achievements": [
                            "gift"
                        ],
                        "events": [
                            {
                                "event": "xp_gained",
                                "amount": 40,
                                "reason": "Achievement: Gift",
                                "leveledUp": false,
                                "newLevel": 1,
                                "total": 40
                            },
                            {
                                "event": "achievement_unlocked",
                                "id": "gift",
                                "name": "Gift",
                                "xp": 40
                            }
                        ]
                    }
                },
                {
                    "op": "unlockAchievement",
                    "id": "gift",
                    "expect": {
                        "returns": false,
                        "player": {
                            "xp": 40
                        },
                        "events": []
                    }
                },
                {
                    "op": "unlockAchievement",
                    "id": "missing",
                    "expect": {
                        "returns": false,
                        "events": []
                    }
                },
                {
                    "op": "unlockAchievement",
                    "id": "__proto__",
                    "expect": {
                        "returns": false,
                        "events": []
                    }
                },
                {
                    "op": "unlockAchievement",
                    "id": "toString",
                    "expect": {
                        "returns": false,
                        "events": []
                    }
                },
                {
                    "op": "markAchievementsSeen",
                    "ids": [
                        "gift",
                        "__proto__",
                        "nope"
                    ],
                    "expect": {
                        "player": {
                            "achievements": {
                                "gift": {
                                    "seen": true
                                }
                            }
                        },
                        "achievements": [
                            "gift"
                        ],
                        "absent": [
                            "achievements.__proto__",
                            "achievements.nope"
                        ],
                        "events": []
                    }
                }
            ]
        },
