        {
            "name": "progress survives a reload",
            "clock": "2026-08-07T09:00:00",
            "config": {
                "builtinAchievements": false
            },
            "steps": [
                {
                    "op": "record",
                    "activity": "g",
                    "result": {
                        "score": 20
                    },
                    "expect": {
                        "player": {
                            "xp": 14
