            ]
        },
        {
            "name": "zero and negative scores earn no bonus and no high score",
            "clock": "2026-08-07T09:00:00",
            "config": {
                "builtinAchievements": false
            },
            "steps": [
                {
                    "op": "record",
                    "activity": "g",
                    "result": {
                        "score": 0
                    },
                    "expect": {
                        "player": {
                            "xp": 10
