                }
            ]
        },
        {
            "name": "an unsafe key in the result is dropped",
            "clock": "2026-08-07T09:00:00",
            "config": {
                "builtinAchievements": false
            },
            "steps": [
                {
                    "op": "record",
                    "activity": "g",
                    "result": {
                        "constructor": 4,
