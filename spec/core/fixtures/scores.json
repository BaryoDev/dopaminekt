                        "events": [
                            {
                                "event": "personal_best",
                                "activity": "g",
                                "score": 20
                            },
                            {
                                "event": "xp_gained",
                                "amount": 14,
                                "reason": "Played g",
                                "leveledUp": false,
                                "newLevel": 1,
                                "total": 14
                            }
                        ]
                    }
                },
                {
                    "op": "reload",
                    "expect": {
                        "player": {
                            "xp": 14,
