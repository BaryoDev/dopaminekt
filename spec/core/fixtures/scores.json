                        ]
                    }
                },
                {
                    "op": "record",
                    "activity": "g",
                    "result": {
                        "score": 9
                    },
                    "expect": {
                        "player": {
                            "xp": 32
                        },
                        "events": [
                            {
                                "event": "personal_best",
                                "activity": "g",
                                "score": 9
                            },
                            {
                                "event": "xp_gained",
                                "amount": 11,
                                "reason": "Played g",
                                "leveledUp": false,
                                "newLevel": 1,
                                "total": 32
