        {
            "name": "the streak multiplier applies to the score bonus",
            "clock": "2026-08-07T09:00:00",
            "config": {
                "builtinAchievements": false
            },
            "note": "The day is counted before the XP, so this game already pays x1.25. (10 + 3) * 1.25 = 16.25, floored to 16.",
            "savedJson": {
                "streak": {
                    "current": 2,
                    "longest": 2,
                    "lastPlayDate": "2026-08-06"
                }
            },
            "afterInit": {
                "player": {
                    "streak": {
                        "current": 2,
                        "lastPlayDate": "2026-08-06"
                    }
                },
                "events": []
            },
            "steps": [
                {
                    "op": "record",
                    "activity": "g",
                    "result": {
                        "score": 15
                    },
                    "expect": {
                        "player": {
                            "xp": 16
                        },
                        "events": [
                            {
                                "event": "streak_updated",
                                "current": 3,
                                "longest": 3
                            },
                            {
                                "event": "personal_best",
                                "activity": "g",
                                "score": 15
                            },
                            {
                                "event": "xp_gained",
                                "amount": 16,
                                "reason": "Played g",
                                "leveledUp": false,
                                "newLevel": 1,
                                "total": 16
                            }
                        ]
                    }
                }
            ]
        },
        {
            "name": "extra result fields add up and unsafe keys are ignored",
            "clock": "2026-08-07T09:00:00",
            "config": {
                "builtinAchievements": false
            },
            "note": "A non-numeric value adds 0 but still creates the stat.",
            "steps": [
                {
                    "op": "record",
                    "activity": "g",
                    "result": {
                        "score": 10,
                        "kills": 3,
                        "label": "x",
                        "__proto__": 7
                    },
                    "expect": {
                        "player": {
                            "xp": 12
                        },
                        "playerExact": {
                            "stats": {
                                "g": {
                                    "plays": 1,
                                    "best": 10,
                                    "kills": 3,
                                    "label": 0
                                }
                            }
                        },
                        "events": [
                            {
                                "event": "personal_best",
                                "activity": "g",
                                "score": 10
                            },
                            {
                                "event": "xp_gained",
                                "amount": 12,
                                "reason": "Played g",
                                "leveledUp": false,
                                "newLevel": 1,
                                "total": 12
                            }
                        ]
                    }
                },
                {
                    "op": "record",
                    "activity": "g",
                    "result": {
                        "kills": 2
                    },
                    "expect": {
                        "player": {
                            "xp": 22
                        },
                        "playerExact": {
                            "stats": {
                                "g": {
                                    "plays": 2,
                                    "best": 10,
                                    "kills": 5,
                                    "label": 0
                                }
                            }
                        },
                        "events": [
                            {
                                "event": "xp_gained",
                                "amount": 10,
                                "reason": "Played g",
                                "leveledUp": false,
                                "newLevel": 1,
                                "total": 22
                            }
                        ]
                    }
                }
            ]
        },
        {
            "name": "a non-numeric score is rejected before anything changes",
            "clock": "2026-08-07T09:00:00",
            "config": {
                "builtinAchievements": false
            },
            "steps": [
                {
                    "op": "record",
                    "activity": "g",
                    "result": {
                        "score": "50"
                    },
                    "expect": {
                        "throws": "TypeError",
                        "player": {
                            "xp": 0,
                            "totalGamesPlayed": 0
                        },
                        "playerExact": {
                            "stats": {}
                        },
                        "events": []
                    }
                },
                {
                    "op": "record",
                    "activity": "g",
                    "result": {
                        "score": 5
                    },
                    "expect": {
                        "player": {
                            "xp": 11,
                            "totalGamesPlayed": 1
                        },
                        "events": [
                            {
                                "event": "personal_best",
                                "activity": "g",
                                "score": 5
                            },
                            {
                                "event": "xp_gained",
                                "amount": 11,
                                "reason": "Played g",
                                "leveledUp": false,
                                "newLevel": 1,
                                "total": 11
                            }
                        ]
                    }
                }
            ]
        },
        {
            "name": "unsafe game names and bad result shapes are rejected",
            "clock": "2026-08-07T09:00:00",
            "config": {
                "builtinAchievements": false
            },
            "steps": [
                {
                    "op": "record",
                    "activity": "__proto__",
                    "expect": {
                        "throws": "TypeError",
                        "events": []
                    }
                },
                {
                    "op": "record",
                    "activity": "constructor",
                    "expect": {
                        "throws": "TypeError",
                        "events": []
                    }
                },
                {
                    "op": "record",
                    "activity": "",
                    "expect": {
                        "throws": "TypeError",
                        "events": []
                    }
                },
                {
                    "op": "record",
                    "activity": "g",
                    "result": null,
                    "expect": {
                        "throws": "TypeError",
                        "events": []
                    }
                },
                {
                    "op": "record",
                    "activity": "g",
                    "result": [
                        1
                    ],
                    "expect": {
                        "throws": "TypeError",
                        "player": {
                            "xp": 0,
                            "totalGamesPlayed": 0
                        },
                        "playerExact": {
                            "stats": {}
                        },
                        "events": []
                    }
                }
            ]
        },
        {
