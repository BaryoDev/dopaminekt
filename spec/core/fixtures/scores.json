{
    "suite": "scores",
    "description": "recordGame: stats, high scores and the score bonus (floor(score / 5) on top of 10, then the streak multiplier).",
    "cases": [
        {
            "name": "a game with no score pays 10 XP",
            "clock": "2026-08-07T09:00:00",
            "config": {
                "builtinAchievements": false
            },
            "steps": [
                {
                    "op": "record",
                    "activity": "g",
                    "expect": {
                        "player": {
                            "xp": 10,
                            "totalGamesPlayed": 1
                        },
                        "playerExact": {
                            "stats": {
                                "g": {
                                    "plays": 1,
                                    "best": 0
                                }
                            }
                        },
                        "events": [
                            {
                                "event": "xp_gained",
                                "amount": 10,
                                "reason": "Played g",
                                "leveledUp": false,
                                "newLevel": 1,
                                "total": 10
                            }
                        ]
                    }
                }
            ]
        },
        {
            "name": "a score of 100 adds a bonus of 20 and sets the high score",
            "clock": "2026-08-07T09:00:00",
            "config": {
                "builtinAchievements": false
            },
            "steps": [
                {
                    "op": "record",
                    "activity": "g",
                    "result": {
                        "score": 100
                    },
                    "expect": {
                        "player": {
                            "xp": 30
                        },
                        "playerExact": {
                            "stats": {
                                "g": {
                                    "plays": 1,
                                    "best": 100
                                }
                            }
                        },
                        "events": [
                            {
                                "event": "personal_best",
                                "activity": "g",
                                "score": 100
                            },
                            {
                                "event": "xp_gained",
                                "amount": 30,
                                "reason": "Played g",
                                "leveledUp": false,
                                "newLevel": 1,
                                "total": 30
                            }
                        ]
                    }
                }
            ]
        },
