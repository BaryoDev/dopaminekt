{
    "suite": "streaks",
    "description": "Daily streaks use local calendar dates, never UTC. The clock is a local date and time. The current streak is derived from the play dates.",
    "cases": [
        {
            "name": "a new player has no streak",
            "clock": "2026-08-07T09:00:00",
            "note": "The streak is derived from the days played. Loading counts no day.",
            "afterInit": {
                "player": {
                    "streak": {
                        "current": 0,
                        "longest": 0
                    }
                },
                "absent": [
                    "streak.lastPlayDate"
                ],
                "events": []
            }
        },
        {
            "name": "the first game starts the streak with no event",
            "clock": "2026-08-07T09:00:00",
            "config": {
                "builtinAchievements": false
            },
            "steps": [
                {
                    "op": "record",
                    "activity": "g",
                    "expect": {
                        "player": {
                            "xp": 10,
                            "streak": {
                                "current": 1,
                                "longest": 1,
                                "lastPlayDate": "2026-08-07"
                            }
                        },
                        "events": [
                            {
                                "event": "xp_gained",
                                "amount": 10,
                                "reason": "Played g",
                                "leveledUp": false,
                                "newLevel": 1,
                                "total": 10
                            }
                        ]
                    }
                }
            ]
        },
